<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
<div id="toast-root"></div>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="page-header">
      <div>
        <h1 class="page-title">Manage Customer Orders</h1>
        <p class="page-subtitle">Track incoming orders, verify UPI payments, update cooking & delivery statuses.</p>
      </div>
    </div>

    <!-- Filter Status Pills Bar -->
    <div class="filter-pills-bar">
      <a href="/admin/orders" class="btn btn-sm <%= !statusFilter ? 'btn-gold' : 'btn-outline' %>">
        All Orders
      </a>
      <% ['PENDING_PAYMENT','PAYMENT_VERIFICATION_PENDING','PLACED','PAID','PREPARING','READY','OUT_FOR_DELIVERY','DELIVERED','CANCELLED'].forEach(s => { %>
        <a href="/admin/orders?status=<%= s %>" class="btn btn-sm <%= statusFilter === s ? 'btn-gold' : 'btn-outline' %>">
          <%= s.replace(/_/g,' ') %>
        </a>
      <% }) %>
    </div>

    <!-- Orders Table Card -->
    <div class="card">
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Order ID</th>
              <th>Customer</th>
              <th>Dishes / Items</th>
              <th>Amount</th>
              <th>Payment</th>
              <th>Distance</th>
              <th>Status</th>
              <th>Quick Update</th>
              <th style="text-align:right;">Details</th>
            </tr>
          </thead>
          <tbody>
            <% if (!orders.length) { %>
              <tr>
                <td colspan="9" style="text-align:center; padding:36px; color:var(--admin-muted);">
                  No orders found under current status filter.
                </td>
              </tr>
            <% } %>
            <% orders.forEach(o => { %>
              <tr data-id="<%= o._id %>">
                <td>
                  <strong style="color:var(--admin-gold-light); font-size:0.95rem;">#<%= String(o._id).slice(-8).toUpperCase() %></strong><br/>
                  <small style="color:var(--admin-muted); font-size:0.75rem;"><%= new Date(o.createdAt).toLocaleString('en-IN') %></small>
                </td>
                <td>
                  <strong style="font-size:0.9rem;"><%= o.user ? o.user.username : 'Guest' %></strong><br/>
                  <small style="color:var(--admin-muted); font-size:0.8rem;"><%= o.user ? o.user.phone : '-' %></small>
                </td>
                <td>
                  <div style="max-width:280px; font-size:0.85rem; line-height:1.4;">
                    <%= o.items.map(i => `${i.name} × ${i.quantity}`).join(', ') %>
                  </div>
                </td>
                <td>
                  <strong style="color:var(--admin-gold-light); font-size:1.05rem;">₹<%= o.totalAmount %></strong>
                </td>
                <td>
                  <% if (o.payment && o.payment.provider === 'cod') { %>
                    <span class="badge-cod">CASH ON DELIVERY</span><br/>
                    <small style="color:var(--admin-muted); font-weight:600; font-size:0.75rem;">Payment: PENDING</small>
                  <% } else if (o.payment && o.payment.provider === 'upi') { %>
                    <span class="badge-upi">UPI</span><br/>
                    <small class="payment-status-text" style="<%= o.payment.status === 'paid' ? 'color:var(--admin-success-light);' : 'color:var(--admin-info-light);' %> font-weight:600; font-size:0.75rem;">
                      <%= o.payment.status === 'paid' ? 'PAID' : 'PENDING VERIFICATION' %>
                    </small>
                    <% if (o.payment.status !== 'paid') { %>
                      <br/>
                      <button type="button" class="btn btn-sm btn-gold btn-verify-upi" data-id="<%= o._id %>" style="padding:3px 10px; font-size:0.75rem; margin-top:4px;">
                        ✓ Verify Payment
                      </button>
                    <% } %>
                  <% } else { %>
                    <span class="badge-online">Online (Razorpay)</span><br/>
                    <small style="color:var(--admin-muted); font-size:0.75rem;">Payment: <%= o.payment && o.payment.status === 'paid' ? 'PAID' : (o.payment?.status?.toUpperCase() || '-') %></small>
                  <% } %>
                </td>
                <td>
                  <span style="font-size:0.85rem; color:var(--admin-muted);">
                    <%= o.distanceKm != null ? o.distanceKm + ' KM' : '-' %>
                  </span>
                </td>
                <td>
                  <span class="status-pill status-<%= o.status %>">
                    <%= o.status.replace(/_/g,' ') %>
                  </span>
                </td>
                <td>
                  <select class="status-select">
                    <% ['PENDING_PAYMENT','PAYMENT_VERIFICATION_PENDING','PLACED','PAID','PREPARING','READY','OUT_FOR_DELIVERY','DELIVERED','CANCELLED'].forEach(s => { %>
                      <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s.replace(/_/g,' ') %></option>
                    <% }) %>
                  </select>
                </td>
                <td style="text-align:right;">
                  <button
                    type="button"
                    class="btn btn-sm btn-outline view-order-btn"
                    data-id="<%= o._id %>"
                    data-display-id="#<%= String(o._id).slice(-8).toUpperCase() %>"
                    data-date="<%= new Date(o.createdAt).toLocaleString('en-IN') %>"
                    data-customer="<%= o.user ? o.user.username : 'Guest' %>"
                    data-phone="<%= o.user ? o.user.phone : '-' %>"
                    data-items='<%= JSON.stringify(o.items) %>'
                    data-amount="<%= o.totalAmount %>"
                    data-payment-provider="<%= o.payment?.provider || 'none' %>"
                    data-payment-status="<%= o.payment?.status || 'unpaid' %>"
                    data-distance="<%= o.distanceKm != null ? o.distanceKm + ' KM' : '-' %>"
                    data-status="<%= o.status %>"
                  >
                    👁️ Details
                  </button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (totalPages > 1) { %>
        <div style="display:flex; gap:8px; margin-top:20px; flex-wrap:wrap; align-items:center;">
          <span style="font-size:0.85rem; color:var(--admin-muted); margin-right:8px;">Page:</span>
          <% for (let p = 1; p <= totalPages; p++) { %>
            <a href="/admin/orders?page=<%= p %><%= statusFilter ? '&status='+statusFilter : '' %>" class="btn btn-sm <%= p === page ? 'btn-gold' : 'btn-outline' %>"><%= p %></a>
          <% } %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<!-- ORDER DETAILS MODAL -->
<div class="admin-modal-overlay" id="orderDetailsModal">
  <div class="admin-modal-box">
    <button type="button" class="admin-modal-close" id="closeOrderModalBtn">&times;</button>
    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:16px;">
      <div>
        <h3 class="section-title" style="margin:0;"><span>🧾</span> Order Details</h3>
        <div style="font-size:1.1rem; color:var(--admin-gold-light); font-weight:700; margin-top:4px;" id="modalOrderId">#00000000</div>
      </div>
      <div id="modalStatusBadge"></div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-bottom:20px; background:rgba(20,16,12,0.6); padding:14px; border-radius:10px; border:1px solid var(--admin-border);">
      <div>
        <div style="font-size:0.75rem; color:var(--admin-muted); text-transform:uppercase;">Customer</div>
        <div style="font-weight:600; font-size:0.95rem;" id="modalCustomer">-</div>
        <div style="font-size:0.82rem; color:var(--admin-muted);" id="modalPhone">-</div>
      </div>
      <div>
        <div style="font-size:0.75rem; color:var(--admin-muted); text-transform:uppercase;">Placed At</div>
        <div style="font-size:0.88rem;" id="modalDate">-</div>
        <div style="font-size:0.82rem; color:var(--admin-muted);" id="modalDistance">Distance: -</div>
      </div>
    </div>

    <!-- Items List -->
    <div style="margin-bottom:18px;">
      <div style="font-size:0.82rem; color:var(--admin-gold-light); font-weight:700; text-transform:uppercase; margin-bottom:8px;">
        Ordered Items
      </div>
      <div id="modalItemsList" style="border:1px solid var(--admin-border); border-radius:10px; overflow:hidden;"></div>
    </div>

    <!-- Payment & Total -->
    <div style="display:flex; justify-content:space-between; align-items:center; padding:14px; background:linear-gradient(135deg, rgba(201,162,75,0.15) 0%, rgba(201,162,75,0.05) 100%); border-radius:10px; border:1px solid var(--admin-border); margin-bottom:20px;">
      <div>
        <div style="font-size:0.75rem; color:var(--admin-muted); text-transform:uppercase;">Payment Info</div>
        <div style="font-weight:700; font-size:0.92rem; text-transform:uppercase;" id="modalPaymentInfo">-</div>
      </div>
      <div style="text-align:right;">
        <div style="font-size:0.75rem; color:var(--admin-muted); text-transform:uppercase;">Total Amount</div>
        <div style="font-size:1.4rem; font-weight:700; color:var(--admin-gold-light);" id="modalTotalAmount">₹0</div>
      </div>
    </div>

    <div style="display:flex; justify-content:flex-end; gap:10px;">
      <button type="button" class="btn btn-outline" id="closeOrderModalFooterBtn">Close</button>
    </div>
  </div>
</div>

<script src="/js/common.js"></script>
<script>
  // Order Details Modal
  const orderModal = document.getElementById('orderDetailsModal');
  const closeOrderModalBtn = document.getElementById('closeOrderModalBtn');
  const closeOrderModalFooterBtn = document.getElementById('closeOrderModalFooterBtn');

  function closeOrderModal() {
    if (orderModal) orderModal.classList.remove('active');
  }
  if (closeOrderModalBtn) closeOrderModalBtn.addEventListener('click', closeOrderModal);
  if (closeOrderModalFooterBtn) closeOrderModalFooterBtn.addEventListener('click', closeOrderModal);
  if (orderModal) {
    orderModal.addEventListener('click', (e) => {
      if (e.target === orderModal) closeOrderModal();
    });
  }

  document.querySelectorAll('.view-order-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.getElementById('modalOrderId').textContent = btn.dataset.displayId;
      document.getElementById('modalCustomer').textContent = btn.dataset.customer;
      document.getElementById('modalPhone').textContent = btn.dataset.phone;
      document.getElementById('modalDate').textContent = btn.dataset.date;
      document.getElementById('modalDistance').textContent = 'Delivery Distance: ' + btn.dataset.distance;
      document.getElementById('modalTotalAmount').textContent = '₹' + btn.dataset.amount;
      document.getElementById('modalPaymentInfo').textContent = `${btn.dataset.paymentProvider.toUpperCase()} (${btn.dataset.paymentStatus.toUpperCase()})`;

      const badgeContainer = document.getElementById('modalStatusBadge');
      const status = btn.dataset.status;
      badgeContainer.innerHTML = `<span class="status-pill status-${status}">${status.replace(/_/g, ' ')}</span>`;

      // Render items list
      let items = [];
      try {
        items = JSON.parse(btn.dataset.items || '[]');
      } catch (e) {
        items = [];
      }

      const itemsListEl = document.getElementById('modalItemsList');
      if (items.length) {
        itemsListEl.innerHTML = items.map(item => `
          <div style="display:flex; justify-content:space-between; align-items:center; padding:10px 14px; border-bottom:1px solid rgba(201,162,75,0.1); background:#14100c;">
            <div>
              <strong style="color:#fff;">${item.name}</strong>
              <span style="color:var(--admin-muted); font-size:0.85rem; margin-left:6px;">× ${item.quantity}</span>
            </div>
            <div style="color:var(--admin-gold-light); font-weight:600;">₹${item.price ? (item.price * item.quantity).toFixed(2) : '-'}</div>
          </div>
        `).join('');
      } else {
        itemsListEl.innerHTML = '<div style="padding:14px; color:var(--admin-muted); text-align:center;">No items recorded</div>';
      }

      if (orderModal) orderModal.classList.add('active');
    });
  });

  // Verify UPI Payment
  document.querySelectorAll('.btn-verify-upi').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.id;
      btn.disabled = true;
      btn.textContent = 'Verifying...';
      try {
        const res = await fetch(`/api/admin/orders/${id}/verify-payment`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message);
        showToast('Payment verified successfully.', 'success');
        const row = btn.closest('tr');
        const statusText = row.querySelector('.payment-status-text');
        if (statusText) {
          statusText.textContent = 'PAID';
          statusText.style.color = 'var(--admin-success-light)';
        }
        const pill = row.querySelector('.status-pill');
        if (pill) {
          pill.className = 'status-pill status-PAID';
          pill.textContent = 'PAID';
        }
        const sel = row.querySelector('.status-select');
        if (sel) sel.value = 'PAID';
        btn.remove();
      } catch (err) {
        showToast(err.message, 'error');
        btn.disabled = false;
        btn.textContent = '✓ Verify Payment';
      }
    });
  });

  // Status Select dropdown
  document.querySelectorAll('.status-select').forEach((sel) => {
    sel.addEventListener('change', async () => {
      const row = sel.closest('tr');
      const id = row.dataset.id;
      const originalValue = sel.value;
      try {
        const res = await fetch(`/api/admin/orders/${id}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: sel.value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message);
        showToast('Order status updated.', 'success');
        const pill = row.querySelector('.status-pill');
        if (pill) {
          pill.className = `status-pill status-${sel.value}`;
          pill.textContent = sel.value.replace(/_/g, ' ');
        }
      } catch (err) {
        showToast(err.message, 'error');
      }
    });
  });
</script>
</body>
</html>
