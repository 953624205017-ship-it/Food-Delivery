<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
<div id="toast-root"></div>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="page-header">
      <div>
        <h1 class="page-title">Customer Reviews Moderation</h1>
        <p class="page-subtitle">Inspect customer dish reviews, publish positive feedback, or hide inappropriate comments.</p>
      </div>
    </div>

    <!-- Filter Pills -->
    <div class="filter-pills-bar">
      <a href="/admin/reviews" class="btn btn-sm <%= statusFilter === 'all' ? 'btn-gold' : 'btn-outline' %>">
        All Reviews
      </a>
      <a href="/admin/reviews?status=approved" class="btn btn-sm <%= statusFilter === 'approved' ? 'btn-gold' : 'btn-outline' %>">
        ✓ Approved
      </a>
      <a href="/admin/reviews?status=hidden" class="btn btn-sm <%= statusFilter === 'hidden' ? 'btn-gold' : 'btn-outline' %>">
        👁️ Hidden
      </a>
    </div>

    <div class="card">
      <div class="table-responsive">
        <% if (!reviews.length) { %>
          <div style="padding:48px 20px; text-align:center; color:var(--admin-muted);">
            <div style="font-size:2.5rem; margin-bottom:10px;">⭐</div>
            <h3 style="margin:0 0 6px 0; color:#fff; font-family:'Fraunces', Georgia, serif;">No Reviews Found</h3>
            <p style="margin:0; font-size:0.88rem;">No customer reviews match the selected filter.</p>
          </div>
        <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>Food Item</th>
                <th>Customer</th>
                <th>Rating</th>
                <th>Comment</th>
                <th>Date</th>
                <th>Status</th>
                <th style="text-align:right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% reviews.forEach(r => { %>
                <tr data-id="<%= r._id %>">
                  <td>
                    <div style="display:flex; align-items:center; gap:10px;">
                      <img
                        src="<%= r.food ? r.food.image : '/images/food-placeholder.svg' %>"
                        alt=""
                        style="width:42px; height:42px; object-fit:cover; border-radius:8px; border:1px solid var(--admin-border);"
                      />
                      <strong style="font-size:0.92rem;"><%= r.food ? r.food.name : 'Unknown Item' %></strong>
                    </div>
                  </td>
                  <td>
                    <strong><%= r.user ? r.user.username : 'Anonymous' %></strong>
                    <% if (r.user && r.user.email) { %>
                      <br/><small style="color:var(--admin-muted); font-size:0.75rem;"><%= r.user.email %></small>
                    <% } %>
                  </td>
                  <td>
                    <span style="color:#fbbf24; font-size:1.05rem; letter-spacing:1px;">
                      <%= '★'.repeat(r.rating) %><%= '☆'.repeat(5 - r.rating) %>
                    </span>
                    <small style="color:var(--admin-muted); font-weight:600;"> (<%= r.rating %>/5)</small>
                  </td>
                  <td style="max-width:280px; word-break:break-word; font-size:0.86rem; line-height:1.4;">
                    <%= r.comment || '<em style="color:var(--admin-muted);">No written comment</em>' %>
                  </td>
                  <td>
                    <small style="color:var(--admin-muted);"><%= new Date(r.createdAt).toLocaleDateString('en-IN') %></small>
                  </td>
                  <td>
                    <span class="status-pill <%= r.status === 'approved' ? 'status-DELIVERED' : 'status-CANCELLED' %>">
                      <%= r.status.toUpperCase() %>
                    </span>
                  </td>
                  <td style="text-align:right; white-space:nowrap;">
                    <div style="display:inline-flex; gap:6px;">
                      <% if (r.status === 'approved') { %>
                        <button type="button" class="btn btn-sm btn-outline toggle-status-btn" data-status="hidden" style="padding:4px 10px; font-size:0.75rem;">
                          Hide
                        </button>
                      <% } else { %>
                        <button type="button" class="btn btn-sm btn-gold toggle-status-btn" data-status="approved" style="padding:4px 10px; font-size:0.75rem;">
                          Approve
                        </button>
                      <% } %>
                      <button type="button" class="btn btn-sm btn-danger delete-review-btn" style="padding:4px 10px; font-size:0.75rem;">
                        Delete
                      </button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script src="/js/common.js"></script>
<script>
  document.querySelectorAll('.toggle-status-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr');
      const id = row.dataset.id;
      const newStatus = btn.dataset.status;
      btn.disabled = true;
      try {
        await apiPatch(`/api/admin/reviews/${id}/status`, { status: newStatus });
        showToast(`Review marked as ${newStatus}!`, 'success');
        setTimeout(() => location.reload(), 400);
      } catch (err) {
        showToast(err.message, 'error');
        btn.disabled = false;
      }
    });
  });

  document.querySelectorAll('.delete-review-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to permanently delete this customer review?')) return;
      const row = btn.closest('tr');
      const id = row.dataset.id;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/reviews/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          row.remove();
          showToast('Review deleted successfully!', 'success');
        } else {
          showToast(data.message || 'Failed to delete review.', 'error');
          btn.disabled = false;
        }
      } catch (err) {
        showToast(err.message, 'error');
        btn.disabled = false;
      }
    });
  });

  async function apiPatch(url, body) {
    const res = await fetch(url, {
      method: 'PATCH',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });
    const data = await res.json();
    if (!res.ok) throw new Error(data.message || 'Request failed');
    return data;
  }
</script>
</body>
</html>
