<div class="admin-sidebar">
  <div class="brand-area">
    <div class="brand-badge"><span>👑</span> Admin Portal</div>
    <div class="brand-title"><%= hotelName %></div>
    <div class="brand-sub"><span class="status-dot"></span> System Online</div>
  </div>

  <a href="/admin" class="nav-item <%= (typeof title !== 'undefined' && title && (title.includes('Dashboard') || title.includes('Analytics'))) ? 'active' : '' %>">
    <span class="nav-icon">📊</span>
    <span>Dashboard</span>
  </a>
  <a href="/admin/foods" class="nav-item <%= (typeof title !== 'undefined' && title && title.includes('Foods')) ? 'active' : '' %>">
    <span class="nav-icon">🍲</span>
    <span>Manage Foods</span>
  </a>
  <a href="/admin/orders" class="nav-item <%= (typeof title !== 'undefined' && title && title.includes('Orders')) ? 'active' : '' %>">
    <span class="nav-icon">📦</span>
    <span>Orders</span>
  </a>
  <a href="/admin/reviews" class="nav-item <%= (typeof title !== 'undefined' && title && title.includes('Reviews')) ? 'active' : '' %>">
    <span class="nav-icon">⭐</span>
    <span>Reviews</span>
  </a>
  <a href="/admin/settings/delivery-zones" class="nav-item <%= (typeof title !== 'undefined' && title && title.includes('Delivery')) ? 'active' : '' %>">
    <span class="nav-icon">📍</span>
    <span>Delivery Zones</span>
  </a>

  <div class="sidebar-bottom">
    <a href="#" class="nav-item logout-link" onclick="logoutAdmin(event)">
      <span class="nav-icon">🚪</span>
      <span>Logout</span>
    </a>
  </div>
</div>

<script>
  (function() {
    const currentPath = window.location.pathname;
    const links = document.querySelectorAll('.admin-sidebar a.nav-item');
    links.forEach(link => {
      const href = link.getAttribute('href');
      if (href && href !== '#' && (currentPath === href || (href !== '/admin' && currentPath.startsWith(href)))) {
        link.classList.add('active');
      }
    });
  })();
</script>
