<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
<div id="toast-root"></div>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <div class="page-header">
      <div>
        <h1 class="page-title">Manage Food Items</h1>
        <p class="page-subtitle">Add dishes, set prices, toggle kitchen availability, and update menu details.</p>
      </div>
      <a href="#addFoodCard" class="btn btn-gold">+ Add New Dish</a>
    </div>

    <!-- Add New Item Card -->
    <div class="card" id="addFoodCard">
      <div class="section-title"><span>🍽️</span> Add New Menu Item</div>
      <form id="addFoodForm" enctype="multipart/form-data">
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:16px;">
          <div class="field">
            <label for="foodName">Dish Name *</label>
            <input type="text" id="foodName" name="name" required placeholder="e.g. Special Chicken Biryani" />
          </div>
          <div class="field">
            <label for="foodPrice">Price (₹) *</label>
            <input type="number" id="foodPrice" name="price" min="0" step="0.01" required placeholder="180" />
          </div>
          <div class="field">
            <label for="foodCategory">Category</label>
            <input type="text" id="foodCategory" name="category" placeholder="e.g. Biryani, Starters, Chinese" />
          </div>
          <div class="field">
            <label for="foodVeg">Dietary Type</label>
            <select id="foodVeg" name="isVeg">
              <option value="false">🍗 Non-Veg</option>
              <option value="true">🌱 Pure Veg</option>
            </select>
          </div>
        </div>

        <div class="field">
          <label for="foodDesc">Description</label>
          <input type="text" id="foodDesc" name="description" placeholder="Short description of ingredients, flavor profile..." />
        </div>

        <div class="field">
          <label>Dish Photo</label>
          <div class="file-upload-wrap">
            <input type="file" id="foodImage" name="image" accept="image/*" style="cursor:pointer;" />
            <div style="font-size:0.8rem; color:var(--admin-muted); margin-top:6px;">
              Supported formats: JPG, PNG, WEBP (Max 5MB)
            </div>
            <img id="addFoodPreview" class="image-preview-box" alt="Image preview" />
          </div>
        </div>

        <div style="margin-top:18px;">
          <button type="submit" class="btn btn-gold" id="addFoodSubmitBtn">
            <span>Add Item to Menu</span>
            <span>&rarr;</span>
          </button>
        </div>
      </form>
    </div>

    <!-- Filter & Food Items Table -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:12px;">
        <h3 class="section-title" style="margin:0;">
          <span>📋</span> All Menu Items (<span id="foodsCount"><%= foods.length %></span>)
        </h3>
        <div style="max-width:320px; width:100%;">
          <input
            type="text"
            id="foodSearchInput"
            class="form-control"
            placeholder="🔍 Search by dish name or category..."
            style="padding:8px 14px; font-size:0.85rem;"
          />
        </div>
      </div>

      <div class="table-responsive">
        <table class="data-table" id="foodsTable">
          <thead>
            <tr>
              <th>Image</th>
              <th>Dish Details</th>
              <th>Category</th>
              <th>Price</th>
              <th>Status</th>
              <th style="text-align:right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (!foods.length) { %>
              <tr>
                <td colspan="6" style="text-align:center; padding:30px; color:var(--admin-muted);">
                  No food items in the database. Use the form above to add your first menu item.
                </td>
              </tr>
            <% } %>
            <% foods.forEach(food => { %>
              <tr data-id="<%= food._id %>" class="food-row">
                <td style="width:56px;">
                  <img
                    src="<%= food.image || '/images/food-placeholder.svg' %>"
                    alt="<%= food.name %>"
                    style="width:48px; height:48px; object-fit:cover; border-radius:8px; border:1px solid var(--admin-border);"
                  />
                </td>
                <td>
                  <strong class="view-name" style="font-size:0.95rem;"><%= food.name %></strong>
                  <% if (food.isVeg) { %>
                    <span style="display:inline-block; font-size:0.7rem; color:#4ade80; background:rgba(74,222,128,0.12); padding:1px 6px; border-radius:4px; margin-left:6px; font-weight:700;">🌱 VEG</span>
                  <% } else { %>
                    <span style="display:inline-block; font-size:0.7rem; color:#f87171; background:rgba(248,113,113,0.12); padding:1px 6px; border-radius:4px; margin-left:6px; font-weight:700;">🍗 NON-VEG</span>
                  <% } %>
                  <% if (food.description) { %>
                    <div style="font-size:0.78rem; color:var(--admin-muted); margin-top:3px; max-width:340px; text-overflow:ellipsis; overflow:hidden; white-space:nowrap;">
                      <%= food.description %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <span style="background:rgba(201,162,75,0.12); border:1px solid var(--admin-border); color:var(--admin-gold-light); font-size:0.75rem; padding:2px 8px; border-radius:6px; font-weight:600;">
                    <%= food.category || 'General' %>
                  </span>
                </td>
                <td>
                  <strong style="color:var(--admin-gold-light); font-size:1.05rem;">₹<span class="view-price"><%= food.price %></span></strong>
                </td>
                <td>
                  <span class="status-pill <%= food.available ? 'status-PAID' : 'status-CANCELLED' %>">
                    <%= food.available ? 'Available' : 'Sold Out' %>
                  </span>
                </td>
                <td style="text-align:right; white-space:nowrap;">
                  <button
                    type="button"
                    class="btn btn-sm btn-outline edit-food-btn"
                    data-id="<%= food._id %>"
                    data-name="<%= food.name %>"
                    data-price="<%= food.price %>"
                    data-category="<%= food.category || 'General' %>"
                    data-desc="<%= food.description || '' %>"
                    data-veg="<%= food.isVeg %>"
                    data-available="<%= food.available %>"
                    data-image="<%= food.image || '' %>"
                    style="margin-right:4px;"
                  >
                    ✏️ Edit
                  </button>
                  <button type="button" class="btn btn-sm btn-outline toggle-btn" style="margin-right:4px;">
                    <%= food.available ? 'Mark Sold Out' : 'Mark Available' %>
                  </button>
                  <button type="button" class="btn btn-sm btn-danger delete-btn">Delete</button>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- EDIT FOOD MODAL -->
<div class="admin-modal-overlay" id="editFoodModal">
  <div class="admin-modal-box">
    <button type="button" class="admin-modal-close" id="closeEditModalBtn">&times;</button>
    <h3 class="section-title" style="margin-top:0;"><span>✏️</span> Edit Food Item</h3>

    <form id="editFoodForm" enctype="multipart/form-data">
      <input type="hidden" id="editFoodId" name="id" />

      <div class="field">
        <label for="editName">Dish Name *</label>
        <input type="text" id="editName" name="name" required />
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
        <div class="field">
          <label for="editPrice">Price (₹) *</label>
          <input type="number" id="editPrice" name="price" min="0" step="0.01" required />
        </div>
        <div class="field">
          <label for="editCategory">Category</label>
          <input type="text" id="editCategory" name="category" />
        </div>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px;">
        <div class="field">
          <label for="editVeg">Dietary Type</label>
          <select id="editVeg" name="isVeg">
            <option value="false">🍗 Non-Veg</option>
            <option value="true">🌱 Pure Veg</option>
          </select>
        </div>
        <div class="field">
          <label for="editAvailable">Kitchen Status</label>
          <select id="editAvailable" name="available">
            <option value="true">Available</option>
            <option value="false">Sold Out</option>
          </select>
        </div>
      </div>

      <div class="field">
        <label for="editDescription">Description</label>
        <textarea id="editDescription" name="description" rows="2"></textarea>
      </div>

      <div class="field">
        <label>Replace Photo (Optional)</label>
        <div class="file-upload-wrap">
          <input type="file" id="editImageInput" name="image" accept="image/*" />
          <img id="editImagePreview" class="image-preview-box" alt="Edit preview" />
        </div>
      </div>

      <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
        <button type="button" class="btn btn-outline" id="cancelEditBtn">Cancel</button>
        <button type="submit" class="btn btn-gold" id="saveEditBtn">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<script src="/js/common.js"></script>
<script>
  // Instant Image Preview on Add Food form
  const addImageInput = document.getElementById('foodImage');
  const addImagePreview = document.getElementById('addFoodPreview');
  if (addImageInput && addImagePreview) {
    addImageInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        addImagePreview.src = URL.createObjectURL(file);
        addImagePreview.style.display = 'inline-block';
      }
    });
  }

  // Instant Image Preview on Edit Food form
  const editImageInput = document.getElementById('editImageInput');
  const editImagePreview = document.getElementById('editImagePreview');
  if (editImageInput && editImagePreview) {
    editImageInput.addEventListener('change', function(e) {
      const file = e.target.files[0];
      if (file) {
        editImagePreview.src = URL.createObjectURL(file);
        editImagePreview.style.display = 'inline-block';
      }
    });
  }

  // Client-side search filter for foods
  const searchInput = document.getElementById('foodSearchInput');
  if (searchInput) {
    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.toLowerCase().trim();
      const rows = document.querySelectorAll('.food-row');
      let visibleCount = 0;
      rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        if (!query || text.includes(query)) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });
      const countEl = document.getElementById('foodsCount');
      if (countEl) countEl.textContent = visibleCount;
    });
  }

  // Add Food Submission Handler
  document.getElementById('addFoodForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const btn = form.querySelector('button[type="submit"]');
    btn.disabled = true;
    try {
      const res = await fetch('/api/admin/foods', { method: 'POST', body: new FormData(form) });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to add item.');
      showToast('Item added successfully.', 'success');
      window.location.reload();
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      btn.disabled = false;
    }
  });

  // Edit Food Modal Handling
  const editModal = document.getElementById('editFoodModal');
  const closeEditModalBtn = document.getElementById('closeEditModalBtn');
  const cancelEditBtn = document.getElementById('cancelEditBtn');

  function closeEditModal() {
    if (editModal) editModal.classList.remove('active');
  }
  if (closeEditModalBtn) closeEditModalBtn.addEventListener('click', closeEditModal);
  if (cancelEditBtn) cancelEditBtn.addEventListener('click', closeEditModal);
  if (editModal) {
    editModal.addEventListener('click', (e) => {
      if (e.target === editModal) closeEditModal();
    });
  }

  document.querySelectorAll('.edit-food-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.id;
      document.getElementById('editFoodId').value = id;
      document.getElementById('editName').value = btn.dataset.name || '';
      document.getElementById('editPrice').value = btn.dataset.price || '';
      document.getElementById('editCategory').value = btn.dataset.category || 'General';
      document.getElementById('editVeg').value = btn.dataset.veg === 'true' ? 'true' : 'false';
      document.getElementById('editAvailable').value = btn.dataset.available === 'true' ? 'true' : 'false';
      document.getElementById('editDescription').value = btn.dataset.desc || '';

      if (btn.dataset.image) {
        editImagePreview.src = btn.dataset.image;
        editImagePreview.style.display = 'inline-block';
      } else {
        editImagePreview.style.display = 'none';
      }

      if (editModal) editModal.classList.add('active');
    });
  });

  document.getElementById('editFoodForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const id = document.getElementById('editFoodId').value;
    const saveBtn = document.getElementById('saveEditBtn');
    saveBtn.disabled = true;
    try {
      const res = await fetch(`/api/admin/foods/${id}`, {
        method: 'PUT',
        body: new FormData(form),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.message || 'Failed to update food.');
      showToast('Food item updated successfully!', 'success');
      window.location.reload();
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      saveBtn.disabled = false;
    }
  });

  // Toggle availability
  document.querySelectorAll('.toggle-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const row = btn.closest('tr');
      const id = row.dataset.id;
      const isAvailable = btn.textContent.includes('Sold Out');
      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/foods/${id}/availability`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ available: !isAvailable }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message);
        showToast('Availability updated.', 'success');
        window.location.reload();
      } catch (err) {
        showToast(err.message, 'error');
        btn.disabled = false;
      }
    });
  });

  // Delete food item
  document.querySelectorAll('.delete-btn').forEach((btn) => {
    btn.addEventListener('click', async () => {
      if (!confirm('Are you sure you want to permanently delete this menu item?')) return;
      const row = btn.closest('tr');
      const id = row.dataset.id;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/foods/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message);
        row.remove();
        showToast('Item deleted successfully.', 'success');
      } catch (err) {
        showToast(err.message, 'error');
        btn.disabled = false;
      }
    });
  });
</script>
</body>
</html>
