<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">
<div id="toast-root"></div>
<div class="admin-shell">
  <%- include('partials/sidebar') %>
  <div class="admin-main">
    <!-- Header with Date Filters -->
    <div class="page-header">
      <div>
        <h1 class="page-title">Analytics Dashboard</h1>
        <p class="page-subtitle">
          Real-time metrics calculated from verified orders and payments.
        </p>
      </div>

      <!-- Date Filter Form -->
      <form action="/admin" method="GET" style="display:flex; align-items:center; gap:8px; flex-wrap:wrap;">
        <input
          type="date"
          name="startDate"
          value="<%= dateFilter.startDate %>"
          class="form-control"
          style="padding:8px 12px; font-size:0.85rem; background:#120e0b; border:1px solid var(--admin-border); color:#fff; border-radius:8px;"
          title="Start date"
        />
        <span style="color:var(--admin-muted); font-size:0.85rem;">to</span>
        <input
          type="date"
          name="endDate"
          value="<%= dateFilter.endDate %>"
          class="form-control"
          style="padding:8px 12px; font-size:0.85rem; background:#120e0b; border:1px solid var(--admin-border); color:#fff; border-radius:8px;"
          title="End date"
        />
        <button type="submit" class="btn btn-sm btn-gold">Filter</button>
        <% if (dateFilter.startDate || dateFilter.endDate) { %>
          <a href="/admin" class="btn btn-sm btn-outline">Reset</a>
        <% } %>
      </form>
    </div>

    <!-- Analytics KPI Cards -->
    <div class="analytics-grid">
      <div class="analytics-card gold">
        <div class="label">Verified Revenue</div>
        <div class="num">₹<%= Number(stats.totalRevenue).toLocaleString('en-IN') %></div>
        <div class="sub-text">Paid orders only (excl. unpaid/cancelled)</div>
      </div>

      <div class="analytics-card green">
        <div class="label">Today's Sales</div>
        <div class="num">₹<%= Number(stats.todayRevenue).toLocaleString('en-IN') %></div>
        <div class="sub-text"><%= stats.todayOrdersCount %> order(s) placed today</div>
      </div>

      <div class="analytics-card blue">
        <div class="label">This Month</div>
        <div class="num">₹<%= Number(stats.monthlyRevenue).toLocaleString('en-IN') %></div>
        <div class="sub-text"><%= stats.monthOrdersCount %> order(s) this calendar month</div>
      </div>

      <div class="analytics-card">
        <div class="label">Total Orders</div>
        <div class="num"><%= stats.totalOrders %></div>
        <div class="sub-text">Lifetime order volume</div>
      </div>

      <div class="analytics-card green">
        <div class="label">Successful Paid</div>
        <div class="num"><%= stats.paidOrdersCount %></div>
        <div class="sub-text">Completed / in delivery</div>
      </div>

      <div class="analytics-card orange">
        <div class="label">Pending Payment</div>
        <div class="num"><%= stats.pendingOrdersCount %></div>
        <div class="sub-text">Awaiting payment or verification</div>
      </div>

      <div class="analytics-card">
        <div class="label">Cancelled Orders</div>
        <div class="num"><%= stats.cancelledOrdersCount %></div>
        <div class="sub-text">Refunded or aborted</div>
      </div>

      <div class="analytics-card gold">
        <div class="label">Customer Reviews</div>
        <div class="num"><%= stats.totalReviewsCount %></div>
        <div class="sub-text">Submitted customer ratings</div>
      </div>
    </div>

    <!-- 7-Day Revenue Trend Chart -->
    <div class="chart-container">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; flex-wrap:wrap; gap:8px;">
        <h3 style="margin:0; font-size:1.05rem; color:#ffffff; font-family:'Fraunces', Georgia, serif;">Last 7 Days Sales Trend</h3>
        <span style="font-size:0.8rem; color:var(--admin-muted);">Daily revenue from verified orders</span>
      </div>

      <div class="chart-bars">
        <% chartDays.forEach(day => { %>
          <% const pct = Math.round((day.sales / maxChartSales) * 100); %>
          <div class="chart-col">
            <div class="chart-val"><%= day.sales > 0 ? '₹' + Math.round(day.sales) : '' %></div>
            <div class="chart-bar" style="height: <%= Math.max(4, pct) %>%;" title="<%= day.date %>: ₹<%= day.sales %> (<%= day.orders %> orders)"></div>
            <div class="chart-label"><%= day.label %></div>
          </div>
        <% }) %>
      </div>
    </div>

    <div class="section-two-col">
      <!-- Best Selling Dishes -->
      <div class="card">
        <h3 class="section-title"><span>🔥</span> Top 5 Best-Selling Dishes</h3>
        <% if (!bestSellers || !bestSellers.length) { %>
          <p style="color:var(--admin-muted); font-size:0.9rem; margin:10px 0;">No sales data available yet.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Rank</th>
                  <th>Dish Name</th>
                  <th style="text-align:center;">Qty Sold</th>
                  <th style="text-align:right;">Revenue</th>
                </tr>
              </thead>
              <tbody>
                <% bestSellers.forEach((item, index) => { %>
                  <tr>
                    <td><strong style="color:var(--admin-gold-light);">#<%= index + 1 %></strong></td>
                    <td><strong><%= item.name %></strong></td>
                    <td style="text-align:center;"><%= item.totalQuantity %></td>
                    <td style="text-align:right; color:var(--admin-gold-light); font-weight:700;">₹<%= Number(item.totalRevenue).toFixed(2) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

      <!-- Quick Action / Menu Summary -->
      <div class="card">
        <h3 class="section-title"><span>⚡</span> Quick Operations</h3>
        <div style="display:flex; flex-direction:column; gap:10px;">
          <a href="/admin/orders?status=PENDING_PAYMENT" class="btn btn-outline btn-block" style="text-align:left; display:flex; justify-content:space-between; align-items:center;">
            <span>Review Pending Orders</span>
            <strong style="color:var(--admin-warning-light);"><%= stats.pendingOrdersCount %></strong>
          </a>
          <a href="/admin/reviews?status=approved" class="btn btn-outline btn-block" style="text-align:left; display:flex; justify-content:space-between; align-items:center;">
            <span>Moderate Customer Reviews</span>
            <strong style="color:var(--admin-gold-light);"><%= stats.totalReviewsCount %></strong>
          </a>
          <a href="/admin/foods" class="btn btn-outline btn-block" style="text-align:left; display:flex; justify-content:space-between; align-items:center;">
            <span>Add / Edit Menu Items</span>
            <strong style="color:#fff;"><%= stats.foodCount %> Items</strong>
          </a>
          <a href="/admin/settings/delivery-zones" class="btn btn-outline btn-block" style="text-align:left; display:flex; justify-content:space-between; align-items:center;">
            <span>Configure Delivery Fee & Zones</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Recent Orders Table -->
    <div class="card">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:8px;">
        <h3 class="section-title" style="margin:0;"><span>🕒</span> Recent Orders</h3>
        <a href="/admin/orders" class="btn btn-sm btn-outline">View All Orders &rarr;</a>
      </div>

      <% if (!recentOrders || !recentOrders.length) { %>
        <p style="color:var(--admin-muted); text-align:center; padding:20px 0; margin:0;">No orders found.</p>
      <% } else { %>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Customer</th>
                <th>Items</th>
                <th>Amount</th>
                <th>Payment</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody>
              <% recentOrders.forEach(o => { %>
                <tr>
                  <td>
                    <strong>#<%= String(o._id).slice(-6).toUpperCase() %></strong><br/>
                    <small style="color:var(--admin-muted);"><%= new Date(o.createdAt).toLocaleDateString('en-IN') %></small>
                  </td>
                  <td>
                    <%= o.user ? o.user.username : 'Guest' %><br/>
                    <small style="color:var(--admin-muted);"><%= o.user ? o.user.phone : '' %></small>
                  </td>
                  <td>
                    <%= (o.items || []).map(i => `${i.name} × ${i.quantity}`).join(', ') %>
                  </td>
                  <td><strong style="color:var(--admin-gold-light);">₹<%= o.totalAmount %></strong></td>
                  <td>
                    <span style="font-size:0.75rem; text-transform:uppercase; font-weight:700;">
                      <%= o.payment?.provider || 'none' %>
                    </span><br/>
                    <small style="color:<%= o.payment?.status === 'paid' ? 'var(--admin-success-light)' : 'var(--admin-muted)' %>; font-weight:600;">
                      <%= o.payment?.status?.toUpperCase() || 'UNPAID' %>
                    </small>
                  </td>
                  <td>
                    <span class="status-pill status-<%= o.status %>">
                      <%= o.status.replace(/_/g, ' ') %>
                    </span>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script src="/js/common.js"></script>
</body>
</html>
