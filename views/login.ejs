<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head') %>
</head>
<body>
<div id="toast-root"></div>
<div class="auth-shell">
  <div class="auth-card">
    <div class="eyebrow">HOTEL LITTLE JAPPAN</div>
    <h1 class="display" style="font-size:1.6rem;">Welcome back</h1>

    <form id="passwordLoginForm">
      <div class="field">
        <label for="pwdIdentifier">Email address or Phone number</label>
        <input type="text" id="pwdIdentifier" name="identifier" required placeholder="Enter your email or 10-digit mobile number" autocomplete="username" />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required placeholder="Your password" autocomplete="current-password" />
      </div>
      <button type="submit" id="pwdLoginBtn" class="btn btn-gold btn-block">Log in</button>
    </form>

    <div class="form-footer-link">New here? <a href="/register">Create an account</a></div>
  </div>
</div>

<script src="/js/common.js"></script>
<script>
  const passwordLoginForm = document.getElementById('passwordLoginForm');
  passwordLoginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('pwdLoginBtn');
    btn.disabled = true;
    btn.textContent = 'Logging in...';
    try {
      const data = await apiPost('/api/auth/login', {
        identifier: document.getElementById('pwdIdentifier').value.trim(),
        password: document.getElementById('password').value,
      });
      window.location.href = data.redirect || '/dashboard';
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      btn.disabled = false;
      btn.textContent = 'Log in';
    }
  });
</script>
</body>
</html>
