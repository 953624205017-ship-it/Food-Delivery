# ==========================================================
# HOTEL LITTLE JAPPAN — Environment Configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
# ==========================================================

# ---------- App ----------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_long_random_string
JWT_SECRET=change_this_to_a_different_long_random_string
JWT_EXPIRES_IN=7d

# ---------- Database ----------
# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/hotel_little_jappan

# ---------- Hotel / Owner Info ----------
HOTEL_NAME=HOTEL LITTLE JAPPAN
OWNER_NAME=Ashok Kumar S
# Owner phone number used for the tel: call-action & order notifications.
# Stored server-side only — never sent to the client except as a tel: link
# generated at request time.
OWNER_PHONE=+91XXXXXXXXXX
HOTEL_ADDRESS=Hotel Little Jappan, Alangulam, Virudhunagar District, Tamil Nadu
HOTEL_LATITUDE=9.0500
HOTEL_LONGITUDE=77.4950

# ---------- OTP (Twilio Verify) ----------
# Sign up at https://www.twilio.com/console
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# ---------- Maps (Geocoding + Distance) ----------
# Google Maps Platform key with Geocoding API + Distance Matrix API enabled.
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=AIzaSyCDhV75wVA04dErzHIjot5DLinpiakyQdg

# ---------- Payments (Razorpay) ----------
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---------- Payments (UPI / Google Pay) ----------
UPI_ID=YOUR_ACTUAL_UPI_ID
UPI_NAME=Hotel Little Jappan

# ---------- Admin bootstrap (used once by scripts/createAdmin.js) ----------
ADMIN_BOOTSTRAP_USERNAME=kani
ADMIN_BOOTSTRAP_PASSWORD=2007
# ---------- Rate limiting ----------
API_RATE_LIMIT_WINDOW_MINUTES=15
API_RATE_LIMIT_MAX=300
